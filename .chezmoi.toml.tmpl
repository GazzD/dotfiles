[data]
  name = "GazzD"
  email = {{ promptStringOnce . "email" "Git email address" | quote }}

{{- if eq .chezmoi.os "linux" }}
  # Monitor layout identifier for this machine.
  # Used in dot_config/hypr/modules/monitors.lua.tmpl
  # Options: "dual" (DP-1 left + HDMI-A-1 right), "single", "laptop"
  monitor_layout = {{ promptStringOnce . "monitor_layout" "Monitor layout (dual/single/laptop)" "dual" | quote }}

  # Google Calendar OAuth2 credentials (for calcurse CalDAV sync)
  google_calendar_client_id = {{ promptStringOnce . "google_calendar_client_id" "Google Calendar OAuth2 Client ID" "603516969252-6osfd4j60941tua6bfmciv5k91br3vr1.apps.googleusercontent.com" | quote }}
  google_calendar_client_secret = {{ promptStringOnce . "google_calendar_client_secret" "Google Calendar OAuth2 Client Secret" | quote }}

  # OpenWeatherMap API key (for waybar weather widget)
  openweathermap_api_key = {{ promptStringOnce . "openweathermap_api_key" "OpenWeatherMap API Key" | quote }}

  # Spotify credentials (for spotify-player TUI)
  spotify_client_id = {{ promptStringOnce . "spotify_client_id" "Spotify Client ID" "d420a117a32841c2b3474932e49fb54b" | quote }}

  # Weather location (for waybar weather widget)
  weather_latitude = {{ promptStringOnce . "weather_latitude" "Weather Location Latitude" "40.4168" | quote }}
  weather_longitude = {{ promptStringOnce . "weather_longitude" "Weather Location Longitude" "-3.7038" | quote }}
{{- end }}
