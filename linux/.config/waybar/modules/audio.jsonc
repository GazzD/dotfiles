{
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false,
    },
    "modules": ["pulseaudio", "pulseaudio/slider", "pulseaudio#microphone"],
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "hands-free": "󰋋",
      "default": [
        "",
        "",
        ""
      ]
    },
    // "on-click": "pavucontrol",
    "on-click": "launch-or-focus-tui wiremix --tab output",
    "tooltip-format": "Output: {volume}%"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "on-click": "launch-or-focus-tui wiremix --tab input",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  }
}
