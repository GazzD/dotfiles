{
  "cpu": {
    "tooltip": false,
    "interval": 10,
    "format": "[CPU {usage:02}%]",
    "format-alt": "[CPU {usage:02}%@{avg_frequency}GHz]",
    "states": {
      "warning": 75,
      "critical": 90,
    },
  },
  "temperature": {
    "tooltip": false,
    "interval": 10,
    // "thermal-zone": 8,
    "hwmon-path": "/sys/devices/pci0000:00/0000:00:01.2/0000:02:00.0/nvme/nvme0/hwmon0/temp1_input",
    "critical-threshold": 80,
    "format": "[TMP {icon}]",
    "format-alt": "[TMP {temperatureC}°C]",
    "format-critical": "[TMP 󱗗 {temperatureC}°C]",
    "format-icons": ["", "", ""],
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true,
    "fallback": "Desktop",
  },
}
