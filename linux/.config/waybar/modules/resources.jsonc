{
  "group/resources": {
    "orientation": "horizontal",
    "modules": ["disk", "memory"],
  },
  "disk": {
    "interval": 30,
    "format": "[DSK {percentage_used:02}%]",
    "format-alt": "[DSK {used}/{total}]",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Used: {used} / {total}\nFree: {free} ({percentage_free}%)",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },
  "memory": {
    "interval": 10,
    "format": "[MEM {percentage:02}%]",
    "format-alt": "[MEM {used:0.1f}G/{total:0.1f}G]",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },
  "cpu": {
    "tooltip": false,
    "interval": 10,
    "format": "[CPU {usage:02}%]",
    "format-alt": "[CPU {usage:02}%@{avg_frequency}GHz]",
    "states": {
      "warning": 75,
      "critical": 90,
    },
  },
  "temperature": {
    "tooltip": false,
    "interval": 10,
    "hwmon-path": "/sys/devices/pci0000:00/0000:00:01.2/0000:02:00.0/nvme/nvme0/hwmon0/temp1_input",
    "critical-threshold": 80,
    "format": "[TMP {icon}]",
    "format-alt": "[TMP {temperatureC}°C]",
    "format-critical": "[TMP 󱗗 {temperatureC}°C]",
    "format-icons": ["", "", ""],
  },
}
