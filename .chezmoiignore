# chezmoi ignore rules
# https://www.chezmoi.io/reference/special-files/chezmoiignore/

# Repo meta files — never deployed
README.md
.editorconfig

# Placeholder files (removed once real content is added)
**/.gitkeep

# nvim — exclude generated/lock files
dot_config/nvim/lazy-lock.json
dot_config/nvim/LICENSE
dot_config/nvim/README.md

# Binary/media assets — no value in tracking these
dot_config/fastfetch/image.png
dot_config/swaync/notification.ogg

# OAuth2 tokens and credentials (auto-generated by apps)
dot_config/calcurse/caldav/oauth2_cred

# Browser data with sensitive keys/passwords
dot_config/mozilla
dot_config/zen
dot_config/chromium

# SSH keys and GPG keys (never backup private keys!)
.ssh/id_*
.ssh/known_hosts*
.gnupg/private-keys-v1.d
.gnupg/trustdb.gpg

# Shell history (may contain passwords/secrets)
.zsh_history
.bash_history
.python_history
.node_repl_history

# Application tokens and caches
dot_config/go/telemetry
dot_config/heroic
dot_config/vesktop/sessionData
dot_config/clipse/clipboard_history.json
dot_config/clipse/tmp_files

# Lock files and state databases
**/*.lock
**/*.boltdb
**/chezmoistate.boltdb

# OS-specific exclusions
{{ if ne .chezmoi.os "linux" }}
# Not on Linux — skip Linux-only configs
dot_config/hypr
dot_config/uwsm
dot_config/satty
dot_config/sunsetr
dot_config/Thunar
dot_config/private_Thunar
dot_config/waybar
dot_config/swaync
dot_config/walker
dot_config/matugen
dot_config/fish
dot_config/lazygit
dot_config/starship.toml
dot_zshrc
{{ end }}

{{ if ne .chezmoi.os "windows" }}
# Not on Windows — skip Windows-only configs
windows
{{ end }}
