{
  "custom/uptime": {
    "exec": "uptime -p | sed 's/up //g' | sed 's/ hours*/h/g' | sed 's/ minutes*/m/g' | sed 's/ days*/d/g' | sed 's/, / /g'",
    "interval": 60,
    "on-click": "launch-or-focus-tui btop",
    "format": "[󱄄 {}]",
    "tooltip": true,
    "tooltip-format": "System Uptime",
  },
  "custom/git": {
    "exec": "~/.config/waybar/scripts/git-status.sh",
    "interval": 5,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Dotfiles git repository status",
    "on-click": "launch-or-focus-tui lazygit -p ~/Projects/dotfiles",
    "return-type": "string",
  },
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 1800,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Click to update system",
    "on-click": "alacritty -e sh -c 'paru -Syu || yay -Syu || sudo pacman -Syu; echo \"\nDone! Press enter to exit...\"; read'",
    "return-type": "string",
  },
  "custom/reload-waybar": {
    "exec": "echo '󰑐'",
    "interval": 86400,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Click to reload Waybar",
    "on-click": "pkill waybar && waybar &",
    "return-type": "string",
  },
  "memory": {
    "interval": 10,
    "format": "[MEM {percentage:02}%]",
    "format-alt": "[MEM {used:0.1f}G/{total:0.1f}G]",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },
  "disk": {
    "interval": 30,
    "format": "[DSK {percentage_used:02}%]",
    "format-alt": "[DSK {used}/{total}]",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Used: {used} / {total}\nFree: {free} ({percentage_free}%)",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },
}
