------------------
---- MONITORS ----
------------------

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
{{ if eq .monitor_layout "dual" -}}
hl.monitor({
    output   = "DP-1",
    mode     = "preferred",
    position = "0x0",
    scale    = "auto",
})
hl.monitor({
    output   = "HDMI-A-1",
    mode     = "preferred",
    position = "2560x0",
    scale    = "auto",
})
{{ else if eq .monitor_layout "laptop" -}}
hl.monitor({
    output   = "eDP-1",
    mode     = "preferred",
    position = "0x0",
    scale    = "auto",
})
{{ else -}}
-- single monitor
hl.monitor({
    output   = "preferred",
    mode     = "preferred",
    position = "0x0",
    scale    = "auto",
})
{{ end -}}
